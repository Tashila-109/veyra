#!/usr/bin/env python3
"""Run verify-veyra's committed sections, each in a fresh bash -c, behind Launch's gate, with Cleanup last.

See SKILL.md, section Run, for the options and the retry rule.
"""
import argparse, ast, hashlib, json, os, pathlib, re, secrets, shutil, signal, subprocess, sys, tempfile, time

SKILL = pathlib.Path(__file__).resolve().parent.parent
REPO = SKILL.parent.parent.parent
sys.path.insert(0,str(SKILL/'bin'))
sys.dont_write_bytecode = True
import pages
PROVIDERS = {'Codex':'codex','Grok':'grok'}
FIRST = ('app-launch','Driving it with veyra ctl')
RELEASE = ('app-launch','Release check')
PERF_ONLY = {('multi-agent','Probe smoke measurements')}
LIVE_PAGES = pages.LIVE
SIGNALS = {signal.SIGTERM,signal.SIGHUP,signal.SIGINT}
INTERRUPT = {'signal':None}

class Interrupted(BaseException):
    """SIGTERM, SIGHUP or SIGINT. The handler blocks all three and raises it, and keep() cannot swallow it."""

def interrupted(number, frame):
    signal.pthread_sigmask(signal.SIG_BLOCK,SIGNALS)
    INTERRUPT['signal'] = INTERRUPT['signal'] or signal.Signals(number).name
    raise Interrupted(signal.Signals(number).name)

def pending():
    """The interrupting signals that arrived while they were blocked."""
    return sorted(signal.Signals(number).name for number in signal.sigpending() if number in SIGNALS)

def take_pending():
    """Take the pending interrupting signals, so each one counts once: sigwait returns at once for a pending one."""
    names = pending()
    for _ in names: signal.sigwait(SIGNALS)
    return names

def start_owned(args, **options):
    """Start a process in its own session with the interrupting signals blocked across the fork, so no signal lands
    between its start and the caller's try. The child unblocks them itself. Returns it and the mask to restore first
    thing inside that try."""
    previous = signal.pthread_sigmask(signal.SIG_BLOCK,SIGNALS)
    try:
        return subprocess.Popen(args,start_new_session=True,
            preexec_fn=lambda: signal.pthread_sigmask(signal.SIG_UNBLOCK,SIGNALS),**options),previous
    except BaseException:
        signal.pthread_sigmask(signal.SIG_SETMASK,previous)
        raise

HEREDOC = re.compile(r"<<'(?P<end>PY[A-Z_]*)'\n(?P<body>.*?)\n(?P=end)(?:\n|$)",re.S)

def page_names():
    """The feature map's page links in order, then any other features/*.md by name, so no page is left out."""
    linked = re.findall(r'^\[[^]]+\]\(([a-z0-9-]+)\.md\)',(SKILL/'features/README.md').read_text(),re.M)
    files = sorted(path.stem for path in (SKILL/'features').glob('*.md') if path.name != 'README.md')
    return [name for name in dict.fromkeys(linked) if name in files]+[name for name in files if name not in linked]

def sections():
    """Map (page, heading) to its one sh block, in file order, for SKILL.md and every page."""
    found = {}
    for path in [SKILL/'SKILL.md',*(SKILL/'features'/(name+'.md') for name in page_names())]:
        source = path.read_text()
        headings = list(re.finditer(r'^##+ (.+)$',source,re.M))
        for index,heading in enumerate(headings):
            end = headings[index+1].start() if index+1 < len(headings) else len(source)
            blocks = re.findall(r'```sh\n(.*?)```',source[heading.end():end],re.S)
            assert len(blocks) <= 1,(path,heading[1])
            if blocks: found[(path.stem,heading[1])] = blocks[0]
    return found

def check_map(found):
    """The plan's fixed sections must exist, so a renamed heading fails loudly instead of dropping its step."""
    for key in [('SKILL','Launch'),('SKILL','Doctor'),('SKILL','Evidence'),('SKILL','Cleanup'),FIRST,RELEASE,
            *sorted(PERF_ONLY)]:
        assert key in found, 'no section '+'/'.join(key)+'; rename it in bin/run too'

def launch_gates(found):
    """Launch's Python calls gate() as a top-level statement before the first statement that calls start()."""
    def calls(node, name):
        return any(isinstance(item,ast.Call) and isinstance(item.func,ast.Name) and item.func.id == name
            for item in ast.walk(node))
    for match in HEREDOC.finditer(found[('SKILL','Launch')]):
        body = ast.parse(match['body']).body
        starts = [index for index,node in enumerate(body) if calls(node,'start')]
        if not starts: continue
        gates = [node for node in body[:starts[0]] if isinstance(node,ast.Expr) and isinstance(node.value,ast.Call)
            and isinstance(node.value.func,ast.Name) and node.value.func.id == 'gate']
        assert gates, 'Launch calls start() without first calling gate()'
        return
    raise AssertionError('Launch never calls start()')

def gate_check():
    """Run driver.gate_self_test() in a scratch checkout, because the driver reads a run's records at import."""
    root = pathlib.Path(tempfile.mkdtemp(prefix='veyra-gate-',dir='/tmp'))
    try:
        (root/'crates/veyra').mkdir(parents=True)
        (root/'crates/veyra/Cargo.toml').write_text('')
        (root/'target/verify-veyra/gatecheck').mkdir(parents=True)
        (root/'target/verify-veyra/gatecheck/lane').write_text('live\n')
        try:
            result = subprocess.run([sys.executable,'-c','import driver; driver.gate_self_test()'],cwd=root,
                capture_output=True,text=True,timeout=30,env=dict(os.environ,RUN='gatecheck',
                PYTHONPATH=str(SKILL/'bin'),PYTHONDONTWRITEBYTECODE='1',VEYRA_VERIFY_TMP=str(root)+'/data-'))
        except subprocess.TimeoutExpired:
            raise AssertionError('gate self-test did not finish in 30 s; gate() can hold past its deadline') from None
        assert result.returncode == 0, 'gate self-test failed:\n'+result.stdout+result.stderr
        return result.stdout.strip()
    finally:
        shutil.rmtree(root)

def verdict(record, counted, late=False):
    """The only place a run's status is decided, after Cleanup has run. None asks for another attempt.

    DONE needs every planned section passed, Cleanup exit 0, an unchanged tree, the proof copy kept under ATTEMPT/run
    and no interrupting signal. A pending signal counts for every outcome and is recorded in the record, which main()
    then writes once as attempt.json. counted is the capture failures so far, and late means the deadline is under a
    minute away.
    """
    failed, seen = record['failed'], record.get('observed') or {}
    taken = take_pending()
    record['interrupted'] = record.get('interrupted') or (taken or [None])[0]
    if record['interrupted']: return 'FAILED: interrupted by '+record['interrupted'],counted
    if record.get('cleanup_exit') not in (0,None) or record.get('scratch_left'):
        return 'FAILED: Cleanup did not pass',counted
    missing = [name for name,kept in record.get('evidence',{'evidence check':False}).items() if not kept]
    if missing: return 'FAILED: required evidence was not kept: '+', '.join(missing)+'; see problems',counted
    if not record['identity_unchanged']: return 'FAILED: the tree changed during the run',counted
    if not failed:
        if record.get('all_passed') and record['cleanup_exit'] == 0: return 'DONE',counted
        return 'FAILED: not every planned section passed',counted
    if failed.get('deadline') or late: return 'BLOCKED: wall-time limit',counted
    if seen.get('human_input'): return None,counted
    if seen.get('kind') == 'capture':
        if counted+1 >= 3: return 'BLOCKED: a third capture failure with no human input',counted+1
        return None,counted+1
    cause = ' at '+seen['kind'] if seen.get('kind') else ''
    return 'FAILED: '+failed['section']+' failed'+cause+' with no human input',counted

def verdict_check():
    done = {'failed':None,'cleanup_exit':0,'identity_unchanged':True,'all_passed':True,'evidence':{'run':True}}
    bad = dict(done,failed={'section':'page/section','exit':1,'deadline':False},all_passed=False)
    def seen(kind, human): return dict(bad,observed={'failure':'step','kind':kind,'human_input':human})
    cases = [(done,0,'DONE'),(dict(done,evidence={'run':False}),0,'FAILED: required evidence'),
        ({key:value for key,value in done.items() if key != 'evidence'},0,'FAILED: required evidence'),
        (dict(done,all_passed=False),0,'FAILED: not every'),(dict(done,cleanup_exit=None),0,'FAILED'),
        (dict(done,interrupted='SIGTERM'),0,'FAILED: interrupted'),(dict(bad,cleanup_exit=1),0,'FAILED: Cleanup'),
        (dict(bad,scratch_left=['x']),0,'FAILED'),(dict(bad,identity_unchanged=False),0,'FAILED: the tree'),
        (dict(bad,failed=dict(bad['failed'],deadline=True)),0,'BLOCKED'),(dict(bad,late=True),0,'BLOCKED'),
        (seen('focus-timeout',True),5,None),(seen('capture',True),5,None),(seen('capture',False),1,None),
        (seen('capture',False),2,'BLOCKED'),(seen('focus-timeout',False),0,'FAILED'),(bad,0,'FAILED')]
    for record,counted,expected in cases:
        status,_ = verdict(record,counted,record.get('late',False))
        assert (status is None) if expected is None else (status or '').startswith(expected),(record,counted,status)

def guards_in_place(found):
    """start()'s relaunch refusal and Cleanup's drain are read as Python structure; the stale-screenshot assert and the
    Swift covered-window guard are checked for presence of their text only."""
    def refuses(body, name):
        return any(isinstance(node,ast.Assert) and isinstance(node.test,ast.UnaryOp)
            and isinstance(node.test.op,ast.Not) and isinstance(node.test.operand,ast.Name)
            and node.test.operand.id == name for node in body)
    def retries(call):
        return any(word.arg == 'retry_exiting' and isinstance(word.value,ast.Constant) and word.value.value is True
            for word in call.keywords)
    cleanup = [ast.parse(match['body']) for match in HEREDOC.finditer(found[('SKILL','Cleanup')])]
    assert any(refuses(tree.body,'other_markers') for tree in cleanup), 'Cleanup no longer asserts not other_markers'
    calls = [node for tree in cleanup for node in ast.walk(tree)
        if isinstance(node,ast.Call) and isinstance(node.func,ast.Name) and node.func.id == 'marked_processes']
    assert calls and all(map(retries,calls)), 'a Cleanup marked_processes call lost retry_exiting=True'
    driver = (SKILL/'bin/driver.py').read_text()
    start = next(node for node in ast.parse(driver).body if isinstance(node,ast.FunctionDef) and node.name == 'start')
    launch = next(index for index,node in enumerate(start.body) if any(isinstance(item,ast.Call)
        and isinstance(item.func,ast.Attribute) and item.func.attr == 'Popen' for item in ast.walk(node)))
    before = start.body[:launch]
    reads = any(isinstance(node,ast.Assign) and [getattr(target,'id',None) for target in node.targets] == ['foreign']
        and isinstance(node.value,ast.Call) and getattr(node.value.func,'id',None) == 'foreign_veyra'
        for node in before)
    assert reads and refuses(before,'foreign'), 'start() no longer refuses a foreign veyra before it launches'
    swift = (SKILL/'bin/capture-window.swift').read_text()
    for where,text,needle in [('Cleanup',found[('SKILL','Cleanup')],'time.monotonic()-started >= 30'),
            ('bin/driver.py',driver,"'stale screenshot after state change: '"),
            ('bin/capture-window.swift',swift,'fail("owned window is covered')]:
        assert needle in text, where+' no longer contains the text of its guard '+needle

def checks(found):
    """Everything --check-only proves; a run repeats it before Launch."""
    blocks = 0
    for key,block in found.items():
        subprocess.run(['bash','-n'],input=block,text=True,check=True)
        for match in HEREDOC.finditer(block):
            compile(match['body'],'/'.join(key),'exec')
            blocks += 1
    compile((SKILL/'bin/driver.py').read_text(),'bin/driver.py','exec')
    check_map(found)
    launch_gates(found)
    guards_in_place(found)
    verdict_check()
    return (f'{len(found)} shell blocks and {blocks} Python heredocs compile across {len(page_names())} pages; '
        'the fixed sections exist; Launch calls gate() before start(); start() asserts its relaunch refusal and '
        'Cleanup its drain; the 30 s drain, stale-screenshot and covered-window guard texts are present; the verdict '
        'holds; '+gate_check())

def identity():
    status = subprocess.check_output(['git','status','--short','--untracked-files=all'],cwd=REPO,text=True)
    untracked = {line[3:]:hashlib.sha256((REPO/line[3:]).read_bytes()).hexdigest()
        for line in status.splitlines() if line.startswith('?? ')}
    return {'head':subprocess.check_output(['git','rev-parse','HEAD'],cwd=REPO,text=True).strip(),'status':status,
        'diff_sha256':hashlib.sha256(subprocess.check_output(['git','diff','HEAD'],cwd=REPO)).hexdigest(),
        'untracked_sha256':untracked}

def plan_for(found, tokens, explicit):
    if explicit:
        steps = [tuple(item.split('/',1)) for item in explicit]
        for step in steps: assert step in found, step
        return [('SKILL','Launch'),*steps]
    selected = None if tokens is None else set(tokens)
    plan = [('SKILL','Launch'),('SKILL','Doctor')]
    for page in page_names():
        if page in LIVE_PAGES: continue
        for key in [key for key in found if key[0] == page]:
            if key in PERF_ONLY: continue
            if key == RELEASE: wanted = selected is None or 'release' in selected
            elif key[1] in PROVIDERS: wanted = selected is None or page+':'+PROVIDERS[key[1]] in selected
            elif key == FIRST: wanted = True
            else: wanted = selected is None or page in selected
            if wanted:
                if key == RELEASE: plan.append(('SKILL','Doctor'))
                plan.append(key)
    return plan+[('SKILL','Doctor'),('SKILL','Evidence')]

def failure_capture(env, out):
    """One best-effort screenshot of the failed state, taken inside attempt()'s try so Cleanup follows whatever it does.

    It returns what happened, its own write error included, and never raises.
    """
    process, result = None, {}
    try:
        process,previous = start_owned(['python3','-c',"from driver import *; capture('failure')"],cwd=REPO,
            env=dict(env,PYTHONPATH=str(SKILL/'bin')),stdout=subprocess.PIPE,stderr=subprocess.STDOUT,text=True)
        signal.pthread_sigmask(signal.SIG_SETMASK,previous)
        output,_ = process.communicate(timeout=60)
        result = {'exit':process.returncode,'output':output[-4000:]}
    except Exception as error:
        result = {'error':f'{type(error).__name__}: {error}'}
    finally:
        if process is not None and process.poll() is None:
            try: os.killpg(process.pid,signal.SIGKILL)
            except ProcessLookupError: pass
            process.wait()
    try: (out/'failure-capture.json').write_text(json.dumps(result,indent=2)+'\n')
    except Exception as error: result['write_error'] = f'{type(error).__name__}: {error}'
    return result

def attempt(found, plan, out, env, deadline, expected, record):
    """One Launch through Cleanup, filling record, which main() made with the attempt's RUN already chosen.

    main() calls it with the interrupting signals blocked. The try unblocks them, so a signal during Launch or a later
    section raises Interrupted there; each section starts with them blocked across its fork. The finally blocks them
    before Cleanup and returns with them blocked, so verdict() in main() reads any that arrived since. Each write here
    goes through keep(), which records its own error in problems instead of raising; verdict() refuses DONE when the
    proof copy was not kept, and main() writes attempt.json once, after the verdict.
    """
    run, problems = record['run'], record['problems']
    timings, current = [], [None]
    proof = REPO/'target/verify-veyra'/run
    def keep(label, write):
        try:
            write()
            return True
        except Exception as error:
            problems.append(f'{label}: {type(error).__name__}: {error}')
            return False
    def note(text):
        def append():
            with (out/'fresh-shell.txt').open('a') as transcript: transcript.write(text)
        keep('fresh-shell.txt',append)
    def execute(key):
        title = '/'.join(key)
        note(f'\n## {title}. Separate bash -c; only exported RUN carries run identity.\n')
        started = time.time()
        process,previous = start_owned(['bash','-c',found[key]],cwd=REPO,env=env,stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,text=True)
        budget = 90 if key == ('SKILL','Cleanup') else max(.01,deadline-time.time())
        try:
            signal.pthread_sigmask(signal.SIG_SETMASK,previous)
            stdout,stderr = process.communicate(timeout=budget)
            code = process.returncode
        except subprocess.TimeoutExpired:
            os.killpg(process.pid,signal.SIGTERM)
            try: stdout,stderr = process.communicate(timeout=3)
            except subprocess.TimeoutExpired:
                os.killpg(process.pid,signal.SIGKILL)
                stdout,stderr = process.communicate()
            stderr += '\nWall-time limit reached; section group stopped; Cleanup follows.\n'
            code = 124
        except BaseException:
            # Anything else interrupting the wait stops this section's own group before Cleanup runs.
            try: os.killpg(process.pid,signal.SIGKILL)
            except ProcessLookupError: pass
            process.wait()
            raise
        timings.append({'section':title,'start_epoch':started,'end_epoch':time.time(),
            'seconds':time.time()-started,'exit':code})
        keep('sections.json',lambda: (out/'sections.json').write_text(json.dumps(timings,indent=2)+'\n'))
        note(stdout+stderr+f'{title} exit={code}\n')
        keep('progress line',lambda: print(title,'exit='+str(code),f'{time.time()-started:.1f}s',flush=True))
        if code: keep('failure tail',lambda: print('\n'.join(line[:300]
            for line in (stdout+stderr).splitlines()[-12:]),flush=True))
        return code,stdout+stderr
    try:
        signal.pthread_sigmask(signal.SIG_UNBLOCK,SIGNALS)
        out.mkdir(parents=True,exist_ok=True)
        keep('plan.json',lambda: (out/'plan.json').write_text(json.dumps(plan,indent=1)+'\n'))
        for key in plan:
            current[0] = '/'.join(key)
            code,text = execute(key)
            if key == ('SKILL','Launch') and not code and identity() != expected:
                record['failed'] = {'section':'tree identity after Launch','exit':None,'deadline':False}
                break
            if code:
                record['failed'] = {'section':'/'.join(key),'exit':code,'deadline':'Wall-time limit reached' in text}
                break
        failed = record['failed']
        if failed:
            receipt = proof/'focus-failure.json'
            try: clock = json.loads(receipt.read_text()) if receipt.exists() else {}
            except (OSError,ValueError) as error:
                problems.append(f'focus-failure.json: {type(error).__name__}: {error}')
                clock = {}
            start = timings[-1]['start_epoch'] if timings else 0
            record['focus'] = clock
            record['observed'] = clock if clock.get('failure') and clock.get('failure_epoch',0) >= start else None
            owed = (proof/'pid').exists() and not failed['deadline']
            if owed and not (record['observed'] or {}).get('human_input'):
                record['failure_capture'] = capture = failure_capture(env,out)
                if 'write_error' in capture: problems.append('failure-capture.json: '+capture['write_error'])
    except (Interrupted,KeyboardInterrupt) as stop:
        record['interrupted'] = record['interrupted'] or str(stop) or 'SIGINT'
    except Exception as error:
        problems.append(f'runner: {type(error).__name__}: {error}')
        record['failed'] = record['failed'] or {'section':'runner','exit':None,'deadline':False}
    finally:
        # Inline, not a call, so no function entry lies between the finally and this try. A signal here has already
        # blocked the signals and set INTERRUPT, as has one raised inside an except clause.
        try: signal.pthread_sigmask(signal.SIG_BLOCK,SIGNALS)
        except Interrupted: pass
        record['interrupted'] = record['interrupted'] or INTERRUPT['signal']
        if record['interrupted'] and not record['failed']:
            record['failed'] = {'section':current[0] or 'runner','exit':None,'deadline':False}
        if record['interrupted']: record['failed']['interrupted'] = record['interrupted']
        try:
            if (proof/'pid').exists(): record['cleanup_exit'] = execute(('SKILL','Cleanup'))[0]
            else:
                # Launch had not started an app, so only the scratch folder of this RUN can exist.
                assert env['VEYRA_VERIFY_TMP'].startswith('/tmp/veyra-')
                shutil.rmtree(env['VEYRA_VERIFY_TMP']+run,ignore_errors=True)
                record['cleanup_exit'] = 0
        except Exception as error:
            problems.append(f'Cleanup: {type(error).__name__}: {error}')
            record['cleanup_exit'] = 1
        scratch = env['VEYRA_VERIFY_TMP']+run
        record['scratch_left'] = [path for path in [scratch,scratch+'-rel'] if os.path.exists(path)]
        if record['scratch_left']: record['cleanup_exit'] = record['cleanup_exit'] or 1
        copied = keep('run copy',lambda: shutil.copytree(proof,out/'run',copy_function=os.link))
        def gate_wait():
            gate = proof/'input-idle-launch.json'
            if gate.exists(): record['gate_wait_seconds'] = json.loads(gate.read_text())['gate_seconds']
        keep('gate wait',gate_wait)
        try: record['identity_unchanged'] = identity() == expected
        except Exception as error:
            problems.append(f'identity: {type(error).__name__}: {error}')
            record['identity_unchanged'] = False
        record['interrupted'] = record['interrupted'] or INTERRUPT['signal'] or (take_pending() or [None])[0]
        passed = {row['section'] for row in timings if row['exit'] == 0}
        record['all_passed'] = all('/'.join(key) in passed for key in plan)
        record['recipe_seconds'] = sum(row['seconds'] for row in timings)
        record['evidence'] = {'run':copied and (out/'run').is_dir()}

def new_run(scratch):
    """A fresh RUN, eight lowercase hex characters, whose proof and scratch folders do not exist yet."""
    while True:
        run = secrets.token_hex(4)
        if not (REPO/'target/verify-veyra'/run).exists() and not os.path.exists(scratch+run): return run

def receipt_error(path, data):
    """Write a required receipt once and read it back. Returns None when it holds data, else the error, which goes to
    stderr because the receipt that would hold it was not kept."""
    try:
        path.write_text(json.dumps(data,indent=2)+'\n')
        if json.loads(path.read_text()) == json.loads(json.dumps(data)): return None
        error = 'it does not read back as written'
    except Exception as failure: error = f'{type(failure).__name__}: {failure}'
    print(f'{path} was not kept: {error}',file=sys.stderr,flush=True)
    return error

def prepare():
    """Everything before the first attempt: options, checks, selection and the tree's identity. Nothing is owned yet,
    so an interrupting signal here simply ends the runner. Returns an exit code, or what the attempts need."""
    parser = argparse.ArgumentParser()
    parser.add_argument('--evidence',type=pathlib.Path)
    parser.add_argument('--base')
    parser.add_argument('--pages',nargs='*')
    parser.add_argument('--sections',nargs='*')
    parser.add_argument('--real-quiet',action='store_true')
    parser.add_argument('--expect-head')
    parser.add_argument('--deadline',type=float,default=time.time()+3*3600)
    parser.add_argument('--scratch',default='/tmp/veyra-verify-')
    parser.add_argument('--check-only',action='store_true')
    args = parser.parse_args()
    found = sections()
    proven = checks(found)
    if args.check_only:
        print('PASS '+proven+'; no launch')
        return 0
    if args.base is not None:
        assert args.pages is None and args.sections is None, '--base replaces --pages and --sections'
        try: args.pages = pages.select(REPO,args.base)
        except subprocess.CalledProcessError as error:
            print('selection from '+args.base+' failed, so nothing ran: '+error.stderr.decode().strip(),file=sys.stderr)
            return 2
        print('selected since '+args.base+': '+(' '.join(args.pages) or 'nothing'),flush=True)
        if not set(args.pages)-LIVE_PAGES:
            for token in sorted(set(args.pages)&LIVE_PAGES):
                print(token+' is due and needs a consented live lane; a fake-CLI run does not drive it',flush=True)
            print('no fake-CLI page is selected since '+args.base+', so nothing launched',flush=True)
            return 0
    assert args.evidence, 'pass --evidence DIR'
    assert args.scratch.startswith('/tmp/veyra-'), 'scratch must start with /tmp/veyra-'
    if args.pages is not None:
        for token in args.pages:
            assert token == 'release' or token.split(':')[0] in page_names(), token
        for token in sorted(set(args.pages)&LIVE_PAGES):
            print(token+' is due and needs a consented live lane; this fake-CLI run does not drive it',flush=True)
    plan = plan_for(found,args.pages,args.sections)
    expected = identity()
    if args.expect_head: assert expected['head'] == args.expect_head, 'checkout is not at '+args.expect_head
    args.evidence.mkdir(parents=True,exist_ok=True)
    (args.evidence/'identity.json').write_text(json.dumps(expected,indent=2)+'\n')
    env = {key:value for key,value in os.environ.items() if key not in ['RUN','DATA','DB','PROOF','PID','PGID',
        'ID','VEYRA_DATA_DIR','VEYRA_CLAUDE_BIN','VEYRA_CODEX_BIN','VEYRA_GROK_BIN','VEYRA_FAKE_FIXTURES',
        'VEYRA_FAKE_FIXTURE','VEYRA_RECORD','VEYRA_VERIFY_REAL_QUIET']}
    env.update(PATH='/opt/homebrew/opt/rustup/bin:'+env['PATH'],VEYRA_VERIFY_LANE='fake',PYTHONDONTWRITEBYTECODE='1',
        VEYRA_VERIFY_TMP=args.scratch,VEYRA_VERIFY_DEADLINE=str(args.deadline))
    if args.real_quiet: env['VEYRA_VERIFY_REAL_QUIET'] = '1'
    if shutil.which('sccache'): env['RUSTC_WRAPPER'] = 'sccache'
    return found,plan,args,env,expected

def main():
    for number in SIGNALS: signal.signal(number,interrupted)
    try: setup = prepare()
    except Interrupted as stop:
        print(f'interrupted by {stop} before any attempt began; nothing was launched',file=sys.stderr,flush=True)
        return 128+signal.Signals[str(stop)].value
    if isinstance(setup,int): return setup
    found,plan,args,env,expected = setup
    attempts, counted, status, lost = [], 0, None, []
    while status is None:
        try: signal.pthread_sigmask(signal.SIG_BLOCK,SIGNALS)
        except Interrupted: pass
        if INTERRUPT['signal']:
            status = 'FAILED: interrupted by '+INTERRUPT['signal']+' between attempts'
            break
        label = f'attempt-{len(attempts)+1}'
        record = {'label':label,'run':new_run(args.scratch),'failed':None,'interrupted':None,'cleanup_exit':None,
            'problems':[]}
        attempts.append(record)
        try: attempt(found,plan,args.evidence/label,dict(env,RUN=record['run']),args.deadline,expected,record)
        except Interrupted: pass  # raised in an except clause; the finally already ran Cleanup and filled record
        # Cleanup has run and the signals are blocked: the verdict comes first, then the one write of attempt.json.
        status,counted = verdict(record,counted,time.time() >= args.deadline-60)
        record['verdict'] = status or 'another attempt'
        error = receipt_error(args.evidence/label/'attempt.json',record)
        if error:
            lost.append('attempt.json')
            status = 'FAILED: attempt.json was not kept: '+error
        if status is None:
            try:
                signal.pthread_sigmask(signal.SIG_UNBLOCK,SIGNALS)
                time.sleep(min(60,max(0,args.deadline-time.time())))
            except Interrupted as stop: status = 'FAILED: interrupted by '+str(stop)+' between attempts'
    try: signal.pthread_sigmask(signal.SIG_BLOCK,SIGNALS)
    except Interrupted: pass
    if receipt_error(args.evidence/'outcome.json',{'status':status,'plan':['/'.join(key) for key in plan],
            'attempts':attempts,'finished_epoch':time.time()}): lost.append('outcome.json')
    late = pending()
    final = status
    if late: final = f'FAILED: interrupted by {late[0]} after the verdict; the receipts keep {status}'
    if lost: final = 'FAILED: '+' and '.join(lost)+' not kept, so the run cannot be DONE'
    print(final,'evidence='+str(args.evidence),flush=True)
    # The last check comes after the final line, so a signal while it is written also counts.
    late = pending()
    if late:
        print(f'FAILED: interrupted by {late[0]} after the verdict, while the receipts or the final line were written; '
            f'the receipts keep {status}',file=sys.stderr,flush=True)
    # Discard what is pending, then restore the mask.
    for number in SIGNALS: signal.signal(number,signal.SIG_IGN)
    signal.pthread_sigmask(signal.SIG_UNBLOCK,SIGNALS)
    if late: return 128+signal.Signals[late[0]].value
    return 0 if status == 'DONE' and not lost else 1

if __name__ == '__main__':
    sys.exit(main() or 0)
